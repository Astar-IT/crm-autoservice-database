generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANCY
// ============================================

model Tenant {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  settings    Json?
  isActive    Boolean   @default(false) @map("is_active")
  isApproved  Boolean   @default(false) @map("is_approved")
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users        User[]
  orders       Order[]
  clients      Client[]
  vehicles     Vehicle[]
  products     Product[]
  warehouses   Warehouse[]
  employees    Employee[]
  services     Service[]
  transactions Transaction[]

  @@index([slug])
  @@index([isActive])
  @@index([isApproved])
  @@map("tenants")
}

// ============================================
// ПОЛЬЗОВАТЕЛИ И РОЛИ
// ============================================

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  MECHANIC
  USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  phone     String?
  role      Role     @default(USER)
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tenantId])
  @@index([role])
  @@map("users")
}

// ============================================
// КЛИЕНТЫ И АВТОМОБИЛИ
// ============================================

model Client {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  tenantId  String    @map("tenant_id")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  orders   Order[]

  @@index([tenantId])
  @@index([phone])
  @@map("clients")
}

model Vehicle {
  id           String   @id @default(uuid())
  brand        String
  model        String
  year         Int?
  vin          String?  @unique
  licensePlate String?  @map("license_plate")
  color        String?
  mileage      Int?     @default(0)
  clientId     String   @map("client_id")
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId])
  @@index([clientId])
  @@index([vin])
  @@map("vehicles")
}

// ============================================
// ЗАКАЗЫ
// ============================================

enum OrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Order {
  id          String      @id @default(uuid())
  number      String      @unique
  status      OrderStatus @default(DRAFT)
  priority    Priority    @default(MEDIUM)
  description String?
  clientId    String      @map("client_id")
  vehicleId   String      @map("vehicle_id")
  tenantId    String      @map("tenant_id")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?   @map("completed_at")

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([clientId])
  @@map("orders")
}

// ============================================
// СКЛАД И ТОВАРЫ
// ============================================

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  address   String?
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("warehouses")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  sku         String?   @unique
  description String?
  price       Decimal   @db.Decimal(10, 2)
  quantity    Int       @default(0)
  warehouseId String    @map("warehouse_id")
  tenantId    String    @map("tenant_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([warehouseId])
  @@index([sku])
  @@map("products")
}

// ============================================
// СОТРУДНИКИ
// ============================================

model Employee {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  position  String?
  salary    Decimal? @db.Decimal(10, 2)
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("employees")
}

// ============================================
// УСЛУГИ
// ============================================

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int?     @default(60)
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("services")
}

// ============================================
// ТРАНЗАКЦИИ
// ============================================

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  tenantId    String          @map("tenant_id")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@map("transactions")
}

